<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Shared NuGet metadata. Every package in src/ gets the same version.
       AppInfoPackageVersion is separate from Version so the sample can reference the local packages
       by it while setting its own Version. -->
  <PropertyGroup>
    <AppInfoPackageVersion>0.1.0</AppInfoPackageVersion>
    <Version>$(AppInfoPackageVersion)</Version>
    <Authors>Kuba</Authors>
    <Copyright>Copyright (c) 2026 Kuba</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>aspnetcore;appinfo;diagnostics;endpoint</PackageTags>
    <PackageProjectUrl>https://github.com/dut00/aspnetcore-appinfo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dut00/aspnetcore-appinfo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Library projects under <repo>/src/ are packable, ship XML docs and a per-package README.
       Anchored to the repo root so a clone inside a folder named "src" doesn't affect tests or samples. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackageReadmeFile)' == 'README.md' And Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Package icon shared by all packages: assets/icon.png (PNG, 128x128 recommended, max 1 MB). -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' And Exists('$(MSBuildThisFileDirectory)assets/icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackageIcon)' == 'icon.png'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
