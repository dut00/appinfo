<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local feed produced by build/pack.ps1, used by the sample with -p:UseLocalPackages=true -->
    <add key="local" value="artifacts" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Dut00.AppInfo" />
      <package pattern="Dut00.AppInfo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
