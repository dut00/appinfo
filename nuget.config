<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Every package, including this repo's own (the package validation baseline), comes from nuget.org.
       The local ./artifacts feed is registered only for the sample, in samples/nuget.config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
