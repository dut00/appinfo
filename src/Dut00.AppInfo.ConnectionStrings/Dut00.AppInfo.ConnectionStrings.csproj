<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Extends the Dut00.AppInfo /appinfo endpoint with the application's connection strings, with passwords, keys and other secrets masked.</Description>
    <PackageTags>$(PackageTags);connectionstrings;masking</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dut00.AppInfo\Dut00.AppInfo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dut00.AppInfo.ConnectionStrings.Tests" />
  </ItemGroup>

</Project>
