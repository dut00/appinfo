<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Extends the Dut00.AppInfo /appinfo endpoint with container and Kubernetes details: whether the app runs in a container or pod, pod name, namespace and node.</Description>
    <PackageTags>$(PackageTags);container;docker;kubernetes;k8s</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dut00.AppInfo\Dut00.AppInfo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dut00.AppInfo.Container.Tests" />
  </ItemGroup>

</Project>
