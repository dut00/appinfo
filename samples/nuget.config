<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Adds the local feed produced by build/pack.ps1, used by the sample with -p:UseLocalPackages=true.
       The more specific patterns win over "*" from the root nuget.config, so the sample never takes these packages
       from nuget.org: a missing local pack fails the restore instead of silently using a published version. -->
  <packageSources>
    <add key="local" value="../artifacts" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Dut00.AppInfo" />
      <package pattern="Dut00.AppInfo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
