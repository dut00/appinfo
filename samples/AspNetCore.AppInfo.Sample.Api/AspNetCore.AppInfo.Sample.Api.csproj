<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Shown as "Version" in the /appinfo response. -->
    <Version>1.0.5</Version>
  </PropertyGroup>

  <!-- Default: build against the source. With -p:UseLocalPackages=true: use the packages from ./artifacts
       (run ./build/pack.ps1 first). -->
  <ItemGroup Condition="'$(UseLocalPackages)' != 'true'">
    <ProjectReference Include="..\..\src\AspNetCore.AppInfo\AspNetCore.AppInfo.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.AppInfo.Configuration\AspNetCore.AppInfo.Configuration.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.AppInfo.ConnectionStrings\AspNetCore.AppInfo.ConnectionStrings.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.AppInfo.Environment\AspNetCore.AppInfo.Environment.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalPackages)' == 'true'">
    <PackageReference Include="AspNetCore.AppInfo" />
    <PackageReference Include="AspNetCore.AppInfo.Configuration" />
    <PackageReference Include="AspNetCore.AppInfo.ConnectionStrings" />
    <PackageReference Include="AspNetCore.AppInfo.Environment" />
  </ItemGroup>

</Project>
