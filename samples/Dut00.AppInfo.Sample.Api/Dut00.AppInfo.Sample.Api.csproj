<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Shown as "Version" in the /appinfo response. -->
    <Version>1.0.5</Version>
  </PropertyGroup>

  <!-- Default: build against the source. With -p:UseLocalPackages=true: use the packages from ./artifacts
       (run ./build/pack.ps1 first). -->
  <ItemGroup Condition="'$(UseLocalPackages)' != 'true'">
    <ProjectReference Include="..\..\src\Dut00.AppInfo\Dut00.AppInfo.csproj" />
    <ProjectReference Include="..\..\src\Dut00.AppInfo.Configuration\Dut00.AppInfo.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Dut00.AppInfo.ConnectionStrings\Dut00.AppInfo.ConnectionStrings.csproj" />
    <ProjectReference Include="..\..\src\Dut00.AppInfo.Environment\Dut00.AppInfo.Environment.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalPackages)' == 'true'">
    <PackageReference Include="Dut00.AppInfo" />
    <PackageReference Include="Dut00.AppInfo.Configuration" />
    <PackageReference Include="Dut00.AppInfo.ConnectionStrings" />
    <PackageReference Include="Dut00.AppInfo.Environment" />
  </ItemGroup>

</Project>
